{
  "schemaVersion": 1,
  "id": "sdemo.planner.widget",
  "appId": "sdemo.planner",
  "name": "待办",
  "description": "桌面待办：显示最多 8 条未完成条目，支持快速添加与勾选完成。",
  "version": "0.1.0",
  "hostApiVersion": "1.0",

  "renderer": "native",
  "native": {
    "process": "SDemo.Planner.exe",
    "layered": true,
    "resizable": false,
    "minSize": { "width": 300, "height": 360 }
  },

  "wasm": null,

  "size": { "width": 320, "height": 440 },

  "layer": "floating",

  "position": {
    "mode": "anchored",
    "corner": "top-right",
    "offsetX": 24,
    "offsetY": 24,
    "snapPx": 12,
    "rememberPerMonitor": true
  },

  "behavior": {
    "alwaysOnTopDefault": false,
    "dragMode": "app",
    "clickThrough": "never",
    "hideBehindFullscreenApp": true,
    "opacity": { "default": 0.94, "min": 0.55 },
    "keepAlive": "onDemand"
  },

  "focus": {
    "stealOnShow": false,
    "activateOnClick": true
  },

  "theme": {
    "mode": "auto",
    "followAccent": true,
    "surface": "opaque"
  },

  "activation": {
    "launchOnStartup": false,
    "showInTray": true
  },

  "permissions": ["http-localhost"],

  "config": {
    "type": "object",
    "properties": {
      "maxItems": {
        "type": "integer",
        "title": "最多显示条数",
        "minimum": 3,
        "maximum": 30,
        "default": 8
      }
    }
  }
}
