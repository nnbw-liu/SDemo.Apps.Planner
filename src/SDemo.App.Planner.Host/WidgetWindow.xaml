<Window x:Class="SDemo.App.Planner.Host.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办组件"
        Width="320" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Topmost="False">

    <Window.Resources>
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="#DCE5F2" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A3350" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#93A1B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A3350" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" CornerRadius="16" Background="#E61B2230" BorderBrush="#34425E" BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Header" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="待办" FontSize="15" FontWeight="SemiBold" Foreground="#E8ECF4" />
                        <TextBlock x:Name="CountText" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#7F8CA3" />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新" Style="{StaticResource GhostButton}"
                            Click="OnRefreshClick" Margin="0,0,4,0" />
                    <Button Grid.Column="2" x:Name="HideButton" Content="×" Style="{StaticResource GhostButton}"
                            Click="OnHideClick" FontSize="13" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="0,10,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="TodoItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,5" Padding="4,4,6,4" CornerRadius="8" Background="#1B2434">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{Binding Glyph}" Tag="{Binding Id}" Click="OnToggleClick"
                                                Style="{StaticResource DotButton}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Margin="6,1,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#E8ECF4"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#8A94A6"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyHint" Text="还没有待办，下面输入一条试试" FontSize="11"
                               Foreground="#6E7A90" Margin="6,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuickAddBox" Height="30" Padding="6,4" VerticalContentAlignment="Center"
                         Background="#121826" BorderBrush="#2C3A55" Foreground="#E8ECF4" CaretBrush="#E8ECF4"
                         FontSize="12" KeyDown="OnQuickAddKeyDown" />
                <Button Grid.Column="1" Content="添加" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                        Click="OnQuickAddClick" FontSize="12" Padding="10,4" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HintText" Text="拖动标题栏移动 · 点击 ○ 完成" FontSize="10" Foreground="#6E7A90"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="OpenButton" Content="打开主窗口" Style="{StaticResource GhostButton}"
                        Click="OnOpenClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
