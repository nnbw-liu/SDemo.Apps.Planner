<Window x:Class="SDemo.App.Planner.Host.TodoEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办"
        Width="460" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="#171D2A" Foreground="#E8ECF4"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12"
        ResizeMode="NoResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="新建待办" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

        <TextBlock Grid.Row="1" Text="标题" Foreground="#8A94A6" FontSize="10" />
        <TextBox Grid.Row="2" x:Name="TitleBox" Height="32" Margin="0,4,0,12" VerticalContentAlignment="Center"
                 MaxLength="200" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="截止日期" Foreground="#8A94A6" FontSize="10" />
                <DatePicker x:Name="DueDate" Height="30" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="时间" Foreground="#8A94A6" FontSize="10" />
                <TextBox x:Name="DueTimeBox" Width="76" Height="30" Margin="0,4,0,0" Text="09:00"
                         VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="优先级" Foreground="#8A94A6" FontSize="10" />
                <ComboBox x:Name="PriorityBox" Height="30" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,7,0,12">
            <TextBlock Text="清单" Foreground="#8A94A6" FontSize="10" VerticalAlignment="Center" />
            <ComboBox x:Name="ListBox" Width="150" Height="26" Margin="8,0,0,0" />
            <TextBlock Text="标签（逗号分隔）" Foreground="#8A94A6" FontSize="10" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBox x:Name="TagsBox" Width="120" Height="26" Margin="8,0,0,0" VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="5" Text="备注" Foreground="#8A94A6" FontSize="10" />
        <TextBox Grid.Row="6" x:Name="NotesBox" Height="140" Margin="0,4,0,12" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" />

        <TextBlock Grid.Row="7" x:Name="ErrorText" Foreground="#F45B69" FontSize="11" VerticalAlignment="Top"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Width="84" Height="32" Margin="0,0,8,0" Click="OnCancelClick"
                    Background="Transparent" Foreground="#C7D2E3" BorderBrush="#2A3550" BorderThickness="1" />
            <Button Content="保存" Width="96" Height="32" Click="OnSaveClick" Background="#2E63C8"
                    Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
