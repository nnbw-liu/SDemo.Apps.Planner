@inherits PlannerPageBase
@inject IJSRuntime JS
@inject AdoImportService Ado
@* 任务只读详情。状态/编辑/延期入口在列表行上，详情里保留「标记完成」与「编辑」。 *@
@if (Ui.ViewingTodo is { } todo)
{
    <Modal Title="@todo.Title" Eyebrow="任务详情" SizeClass="modal-md" OnClose="Close">
        <ChildContent>
            <div class="task-detail-badges">
                <span class="status-pill @StatusClass(todo.Status)">@StatusLabel(todo.Status)</span>
                <span class="kind @KindClass(todo.Kind)">
                    <Icon Name="@KindIcon(todo.Kind)" Size="12" /> @KindLabel(todo.Kind)
                </span>
                @if (todo.Priority == 1)
                {
                    <span class="task-detail-flag"><Icon Name="flame" Size="12" /> 高优先级</span>
                }
                @if (todo.ExternalSource == "azure-devops" && todo.ExternalId is not null)
                {
                    <a class="ado-chip" href="@(string.IsNullOrWhiteSpace(todo.ExternalUrl) ? "#" : todo.ExternalUrl)"
                       target="_blank" rel="noreferrer" title="在 Azure DevOps 中打开">
                        <Icon Name="link" Size="12" /> ADO #@todo.ExternalId
                    </a>
                }
            </div>

            @if (todo.ExternalSource == "azure-devops" && todo.ExternalId is not null)
            {
                <div class="ado-task-actions">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="PushToAdo" disabled="@_adoBusy">
                        <Icon Name="upload" Size="13" /> @(_adoBusy ? "同步中…" : "同步到云端")
                    </button>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="PullFromAdo" disabled="@_adoBusy">
                        <Icon Name="download" Size="13" /> 从云端同步
                    </button>
                    <span class="ado-task-hint">
                        推送标题 / 说明 / 状态 / 优先级 · rev @(todo.ExternalRev?.ToString() ?? "—")
                    </span>
                </div>
            }

            <dl class="detail-grid">
                <div>
                    <dt>状态</dt>
                    <dd>
                        <SelectBox TValue="TodoStatus"
                                   Compact="true"
                                   Class="detail-status-select"
                                   Value="todo.Status"
                                   ValueChanged="status => ChangeStatus(todo, status)"
                                   Options="StatusOptions" />
                    </dd>
                </div>
                <div>
                    <dt>优先级</dt>
                    <dd>@PriorityLabel(todo.Priority)</dd>
                </div>
                <div>
                    <dt>项目</dt>
                    <dd>
                        @if (todo.ProjectName is not null)
                        {
                            <span class="meta-item">
                                <span class="project-dot" style="--dot:@(todo.ProjectColor ?? "#4C8DFF")"></span>
                                @todo.ProjectName
                            </span>
                        }
                        else
                        {
                            <span class="detail-empty">未归属项目</span>
                        }
                    </dd>
                </div>
                <div>
                    <dt>迭代</dt>
                    <dd>@(string.IsNullOrWhiteSpace(todo.IterationName) ? "未挂迭代" : todo.IterationName)</dd>
                </div>
                @if (todo.ParentTodoId is not null)
                {
                    <div>
                        <dt>来源任务</dt>
                        <dd>
                            @if (_parentTodo is { } parent)
                            {
                                <button type="button" class="task-link" @onclick="() => OpenTodo(parent)">@parent.Title</button>
                            }
                            else
                            {
                                <span class="detail-empty">原任务已删除</span>
                            }
                        </dd>
                    </div>
                }
                <div>
                    <dt>截止时间</dt>
                    <dd>@FormatTime(todo.DueAt)</dd>
                </div>
                <div>
                    <dt>创建于</dt>
                    <dd>@FormatTime(todo.CreatedAt)</dd>
                </div>
                <div>
                    <dt>更新于</dt>
                    <dd>@FormatTime(todo.UpdatedAt)</dd>
                </div>
                <div>
                    <dt>完成于</dt>
                    <dd>@FormatTime(todo.CompletedAt)</dd>
                </div>
            </dl>

            <section class="task-detail-section">
                <div class="task-detail-section-head">
                    <span class="eyebrow">任务说明</span>
                    @if (!string.IsNullOrWhiteSpace(todo.Notes))
                    {
                        <button class="icon-btn copy-btn" type="button" title="复制任务说明"
                                @onclick="() => CopyNotes(todo.Notes)">
                            <Icon Name="copy" Size="14" />
                        </button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(todo.Notes))
                {
                    <p class="task-detail-notes">@todo.Notes</p>
                }
                else
                {
                    <p class="task-detail-notes empty">还没有填写说明。点右下角「编辑任务」补充背景、验收标准或参考链接。</p>
                }
            </section>

            @if (todo.Kind != WorkItemKind.Bug)
            {
                <section class="task-detail-section">
                    <div class="task-detail-section-head">
                        <span class="eyebrow">关联 Bug</span>
                        @if (_linkedBugs.Count > 0)
                        {
                            <span class="linked-bug-meta">@_linkedBugs.Count</span>
                        }
                        <button type="button" class="btn btn-ghost btn-sm push-right" @onclick="() => Ui.OpenBugEditor(todo)">
                            <Icon Name="bug" Size="13" /> 新建 Bug
                        </button>
                    </div>
                    @if (_relationError is not null)
                    {
                        <p class="linked-bug-empty">@_relationError</p>
                    }
                    else if (_linkedBugs.Count == 0)
                    {
                        <p class="linked-bug-empty">还没有关联 Bug。发现问题时可以直接从这条任务派生，一个任务可以挂多个。</p>
                    }
                    else
                    {
                        <ul class="linked-bug-list">
                            @foreach (var bug in _linkedBugs)
                            {
                                <li>
                                    <button type="button" class="linked-bug" @onclick="() => OpenTodo(bug)">
                                        <span class="status-pill @StatusClass(bug.Status)">@StatusLabel(bug.Status)</span>
                                        <span class="linked-bug-title">@bug.Title</span>
                                        <span class="linked-bug-meta">@PriorityLabel(bug.Priority)</span>
                                        <Icon Name="chevron-right" Size="12" />
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(todo.CompletionNote))
            {
                <section class="task-detail-section">
                    <span class="eyebrow">完成说明</span>
                    <p class="task-detail-notes">@todo.CompletionNote</p>
                </section>
            }

            @if (todo.Artifacts.Count > 0)
            {
                <section class="task-detail-section">
                    <span class="eyebrow">产物 / 链接</span>
                    <ul class="task-detail-artifacts">
                        @foreach (var artifact in todo.Artifacts)
                        {
                            <li>
                                @if (Uri.TryCreate(artifact, UriKind.Absolute, out var uri))
                                {
                                    <a href="@uri" target="_blank" rel="noreferrer">@artifact</a>
                                }
                                else
                                {
                                    <span>@artifact</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }

            @if (todo.Tags.Count > 0)
            {
                <section class="task-detail-section">
                    <span class="eyebrow">标签</span>
                    <p class="task-detail-notes">#@string.Join(" #", todo.Tags)</p>
                </section>
            }

            <AttachmentPanel OwnerType="AttachmentOwnerTypes.Todo" OwnerId="@todo.Id" />

            <section class="task-detail-section">
                <span class="eyebrow">操作记录</span>
                @if (_historyError is not null)
                {
                    <p class="task-detail-notes empty">@_historyError</p>
                }
                else if (_history.Count == 0)
                {
                    <p class="task-detail-notes empty">还没有操作记录。创建、修改、调整优先级或状态后都会记在这里。</p>
                }
                else
                {
                    <ol class="task-history">
                        @foreach (var entry in _history)
                        {
                            <li class="task-history-item">
                                <div class="task-history-head">
                                    <strong>@entry.Action</strong>
                                    <time>@entry.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time>
                                </div>
                                <div class="task-history-meta">
                                    @ActorLabel(entry.Actor)
                                    @if (!string.IsNullOrWhiteSpace(entry.Reason))
                                    {
                                        <span> · @entry.Reason</span>
                                    }
                                </div>
                                @if (entry.Changes.Count > 0)
                                {
                                    <ul class="task-history-changes">
                                        @foreach (var change in entry.Changes)
                                        {
                                            <li>
                                                <span class="task-history-field">@change.Field</span>
                                                <span class="task-history-before">@change.Before</span>
                                                <Icon Name="arrow-right" Size="10" />
                                                <span class="task-history-after">@change.After</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>
        </ChildContent>

        <Footer>
            <button class="btn btn-danger btn-sm" style="margin-right:auto" @onclick="Delete">
                @(_confirmDelete ? "确认删除" : "删除任务")
            </button>
            <button class="btn btn-ghost" @onclick="Close">关闭</button>
            @if (!IsTerminal(todo.Status))
            {
                <button class="btn btn-ghost" @onclick="Complete">
                    <Icon Name="check" Size="15" /> 标记完成
                </button>
            }
            <button class="btn btn-primary" @onclick="Edit">
                <Icon Name="edit" Size="15" /> 编辑任务
            </button>
        </Footer>
    </Modal>
}

@code {
    private IReadOnlyList<TodoHistoryEntryDto> _history = [];
    private IReadOnlyList<TodoDto> _linkedBugs = [];
    private TodoDto? _parentTodo;
    private string? _historyError;
    private string? _relationError;
    private bool _adoBusy;
    private bool _confirmDelete;

    private static readonly IReadOnlyList<SelectOption<TodoStatus>> StatusOptions =
    [
        new(TodoStatus.Open, "新建"),
        new(TodoStatus.Doing, "进行中"),
        new(TodoStatus.Done, "已完成"),
        new(TodoStatus.Verified, "已验证"),
        new(TodoStatus.Closed, "已关闭"),
        new(TodoStatus.Canceled, "已取消"),
    ];

    protected override void Reload()
    {
        _confirmDelete = false;
        if (Ui.ViewingTodo is not { } todo)
        {
            _history = [];
            _linkedBugs = [];
            _parentTodo = null;
            return;
        }

        try
        {
            _history = Service.ListTodoHistory(todo.Id);
            _historyError = null;
        }
        catch
        {
            _history = [];
            _historyError = "操作记录暂时读取失败，稍后重新打开详情再试。";
        }

        try
        {
            _linkedBugs = todo.Kind == WorkItemKind.Bug
                ? []
                : Service.ListTodos(new TodoQuery
                {
                    Status = "all",
                    ParentTodoId = todo.Id,
                    Kind = WorkItemKind.Bug,
                    Sort = TodoSort.Status,
                    Limit = 50,
                });
            _parentTodo = todo.ParentTodoId is { } parentId ? Service.GetTodo(parentId) : null;
            _relationError = null;
        }
        catch
        {
            _linkedBugs = [];
            _parentTodo = null;
            _relationError = "关联 Bug 暂时读取失败，稍后重新打开详情再试。";
        }
    }

    private void OpenTodo(TodoDto target)
    {
        if (Ui.ViewingTodo?.Id == target.Id)
        {
            return;
        }

        Ui.CloseTaskDetail();
        Ui.OpenTaskDetail(target);
        Reload();
    }

    private void Close() => Ui.CloseTaskDetail();

    private void Delete()
    {
        if (Ui.ViewingTodo is not { } todo)
        {
            return;
        }

        if (!_confirmDelete)
        {
            _confirmDelete = true;
            return;
        }

        try
        {
            Service.DeleteTodo(todo.Id, todo.Revision, "用户删除", WriteContext.Manual());
            Ui.Toast("任务已移入回收站");
            _confirmDelete = false;
            Ui.CloseTaskDetail();
        }
        catch (PlannerException ex)
        {
            _confirmDelete = false;
            Ui.Toast(ex.Message);
        }
    }

    private async Task PushToAdo()
    {
        if (Ui.ViewingTodo is not { } todo || _adoBusy)
        {
            return;
        }

        _adoBusy = true;
        try
        {
            var result = await Ado.PushTodoAsync(todo.Id);
            Ui.Toast(result.Message);
        }
        catch (PlannerException ex)
        {
            Ui.Toast($"推送失败：{ex.Message}");
        }
        finally
        {
            _adoBusy = false;
        }
    }

    private async Task PullFromAdo()
    {
        if (Ui.ViewingTodo is not { } todo || _adoBusy)
        {
            return;
        }

        _adoBusy = true;
        try
        {
            var result = await Ado.PullTodoAsync(todo.Id);
            Ui.Toast(result.Message);
            if (result.Ok)
            {
                var refreshed = Service.GetTodo(todo.Id);
                if (refreshed is not null)
                {
                    Ui.OpenTaskDetail(refreshed);
                }

                Reload();
            }
        }
        catch (PlannerException ex)
        {
            Ui.Toast($"拉取失败：{ex.Message}");
        }
        finally
        {
            _adoBusy = false;
        }
    }

    private async Task CopyNotes(string text)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("plannerClipboard.copy", text);
            Ui.Toast(ok ? "任务说明已复制" : "复制失败，请手动选中文本复制");
        }
        catch (JSException)
        {
            Ui.Toast("复制失败，请手动选中文本复制");
        }
    }

    private void Edit()
    {
        if (Ui.ViewingTodo is not { } todo)
        {
            return;
        }

        Ui.CloseTaskDetail();
        Ui.OpenTask(todo);
    }

    private void Complete()
    {
        if (Ui.ViewingTodo is not { } todo)
        {
            return;
        }

        Ui.CloseTaskDetail();
        Ui.OpenComplete(todo);
    }

    /// <summary>
    /// 详情里的状态下拉：非终态直接改；终态要走完成弹窗补完成说明与产物。
    /// </summary>
    private void ChangeStatus(TodoDto todo, TodoStatus status)
    {
        if (status == todo.Status)
        {
            return;
        }

        if (status is TodoStatus.Done or TodoStatus.Verified or TodoStatus.Closed or TodoStatus.Canceled)
        {
            Ui.CloseTaskDetail();
            Ui.OpenComplete(todo, status);
            return;
        }

        try
        {
            Service.SetTodoStatus(
                todo.Id,
                todo.Revision,
                status,
                todo.CompletionNote,
                todo.Artifacts,
                WriteContext.Manual());

            var refreshed = Service.GetTodo(todo.Id);
            if (refreshed is not null)
            {
                Ui.OpenTaskDetail(refreshed);
            }

            Ui.Toast($"「{todo.Title}」已改为{StatusLabel(status)}");
        }
        catch (PlannerException ex)
        {
            Ui.Toast(ex.Message);
        }
    }

    private static bool IsTerminal(TodoStatus status) =>
        status is TodoStatus.Done or TodoStatus.Verified or TodoStatus.Closed or TodoStatus.Canceled;

    private static string StatusLabel(TodoStatus status) => status switch
    {
        TodoStatus.Doing => "进行中",
        TodoStatus.Done => "已完成",
        TodoStatus.Verified => "已验证",
        TodoStatus.Closed => "已关闭",
        TodoStatus.Canceled => "已取消",
        _ => "新建",
    };

    private static string StatusClass(TodoStatus status) => status switch
    {
        TodoStatus.Doing => "status-doing",
        TodoStatus.Done => "status-done",
        TodoStatus.Verified => "status-verified",
        TodoStatus.Closed => "status-closed",
        TodoStatus.Canceled => "status-canceled",
        _ => "status-open",
    };

    private static string KindIcon(WorkItemKind kind) => kind switch
    {
        WorkItemKind.Bug => "bug",
        WorkItemKind.Research => "research",
        WorkItemKind.Chore => "chore",
        _ => "check",
    };

    private static string PriorityLabel(int priority) => priority switch
    {
        1 => "高优先级",
        3 => "低优先级",
        _ => "中优先级",
    };

    private static string ActorLabel(string actor) => actor switch
    {
        "manual" => "本人操作",
        "ai" => "AI 草稿",
        "meeting" => "会议来源",
        "import" => "导入",
        "ics" => "ICS 同步",
        "system" => "系统",
        _ => actor,
    };

    private static string FormatTime(DateTimeOffset? value) =>
        value is null ? "—" : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
}
