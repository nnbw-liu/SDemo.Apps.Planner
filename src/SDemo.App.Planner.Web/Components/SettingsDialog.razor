@using SDemo.App.Planner.Web
@inherits PlannerPageBase
@inject ThemeService Theme

<Modal Title="设置" Eyebrow="Preferences" SizeClass="modal-lg" OnClose="Close">
    <ChildContent>
        <div class="settings-shell">
            <nav class="settings-nav">
                <button class="settings-nav-item active" type="button">
                    <Icon Name="settings" Size="15" />
                    <span>通用设置</span>
                </button>
                <p class="settings-nav-note">更多分组之后再加。</p>
            </nav>

            <div class="settings-body">
                <section class="settings-section">
                    <header class="settings-section-head">
                        <h3>外观</h3>
                        <p>默认跟随系统外观；切换后立即生效，下次启动沿用。</p>
                    </header>

                    <div class="theme-options">
                        @foreach (var option in Options)
                        {
                            <button type="button"
                                    class="theme-option @(Theme.Mode == option.Mode ? "active" : "")"
                                    @onclick="() => SetMode(option.Mode)">
                                <span class="theme-option-icon"><Icon Name="@option.Icon" Size="18" /></span>
                                <span class="theme-option-text">
                                    <strong>@option.Label</strong>
                                    <small>@option.Hint</small>
                                </span>
                                @if (Theme.Mode == option.Mode)
                                {
                                    <Icon Name="check" Size="15" Class="theme-option-check" />
                                }
                            </button>
                        }
                    </div>

                    <p class="settings-footnote">
                        当前实际显示：@(Theme.IsDark ? "深色" : "浅色")。
                        标题栏会跟着一起换色。
                    </p>
                </section>

                <section class="settings-section settings-about">
                    <header class="settings-section-head">
                        <h3>关于</h3>
                        <p>当前安装版本；升级后这里会随程序更新。</p>
                    </header>

                    <div class="settings-version">
                        <span class="settings-version-label">当前版本</span>
                        <span class="settings-version-number">v@(PlannerConstants.AppVersion)</span>
                    </div>

                    <p class="settings-footnote">宿主 API @(PlannerConstants.HostApiVersion)。</p>
                </section>
            </div>
        </div>
    </ChildContent>
</Modal>

@code {
    private static readonly ThemeOption[] Options =
    {
        new(ThemeMode.System, "monitor", "跟随系统", "与 Windows 的浅色/深色设置保持一致"),
        new(ThemeMode.Light, "sun", "浅色", "清爽的浅灰底，适合白天"),
        new(ThemeMode.Dark, "moon", "深色", "默认的深色界面，适合夜间"),
    };

    private async Task SetMode(ThemeMode mode)
    {
        if (Theme.Mode == mode)
        {
            return;
        }

        await Theme.SetModeAsync(mode);
        StateHasChanged();
    }

    private void Close() => Ui.CloseSettings();

    private sealed record ThemeOption(ThemeMode Mode, string Icon, string Label, string Hint);
}
