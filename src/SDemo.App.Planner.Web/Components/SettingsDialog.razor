@using SDemo.App.Planner.Web
@inherits PlannerPageBase
@inject ThemeService Theme
@inject AdoImportService Ado
@inject IPlatformFiles Files

<Modal Title="设置" Eyebrow="Preferences" SizeClass="modal-lg" OnClose="Close">
    <ChildContent>
        <div class="settings-shell">
            <nav class="settings-nav">
                <button class="settings-nav-item @(_section == "general" ? "active" : "")" type="button" @onclick="ShowGeneral">
                    <Icon Name="settings" Size="15" />
                    <span>通用设置</span>
                </button>
                <button class="settings-nav-item @(_section == "mcp" ? "active" : "")" type="button" @onclick="ShowMcp">
                    <Icon Name="layers" Size="15" />
                    <span>MCP 服务</span>
                </button>
                <button class="settings-nav-item @(_section == "ado" ? "active" : "")" type="button" @onclick="ShowAdo">
                    <Icon Name="link" Size="15" />
                    <span>Azure DevOps</span>
                </button>
                <button class="settings-nav-item @(_section == "attachments" ? "active" : "")" type="button" @onclick="ShowAttachments">
                    <Icon Name="folder" Size="15" />
                    <span>附件存储</span>
                </button>
            </nav>

            <div class="settings-body">
                @if (_section == "general")
                {
                    <section class="settings-section">
                        <header class="settings-section-head">
                            <h3>外观</h3>
                            <p>默认跟随系统外观；切换后立即生效，下次启动沿用。</p>
                        </header>

                        <div class="theme-options">
                            @foreach (var option in Options)
                            {
                                <button type="button"
                                        class="theme-option @(Theme.Mode == option.Mode ? "active" : "")"
                                        @onclick="() => SetMode(option.Mode)">
                                    <span class="theme-option-icon"><Icon Name="@option.Icon" Size="18" /></span>
                                    <span class="theme-option-text">
                                        <strong>@option.Label</strong>
                                        <small>@option.Hint</small>
                                    </span>
                                    @if (Theme.Mode == option.Mode)
                                    {
                                        <Icon Name="check" Size="15" Class="theme-option-check" />
                                    }
                                </button>
                            }
                        </div>

                        <p class="settings-footnote">
                            当前实际显示：@(Theme.IsDark ? "深色" : "浅色")。
                            标题栏会跟着一起换色。
                        </p>
                    </section>

                    <section class="settings-section settings-about">
                        <header class="settings-section-head">
                            <h3>关于</h3>
                            <p>当前安装版本；升级后这里会随程序更新。</p>
                        </header>

                        <div class="settings-version">
                            <span class="settings-version-label">当前版本</span>
                            <span class="settings-version-number">v@(PlannerConstants.AppVersion)</span>
                        </div>

                        <p class="settings-footnote">宿主 API @(PlannerConstants.HostApiVersion)。</p>
                    </section>
                }
                else if (_section == "ado")
                {
                    <section class="settings-section">
                        <header class="settings-section-head">
                            <h3>Azure DevOps</h3>
                            <p>只读镜像：冲刺与任务从 ADO 同步进来，ADO 是权威源，本地手工条目不会被改动。这里只配「连得上」——集合地址与 PAT；同步哪个云端项目、拉哪些人/迭代，到项目页里设置。</p>
                        </header>

                        @if (_adoError is not null)
                        {
                            <p class="form-error">@_adoError</p>
                        }

                        <div class="settings-master @(_adoEnabled ? "" : "is-off")">
                            <div>
                                <strong>启用 Azure DevOps 接入</strong>
                                <small>@(_adoEnabled ? "项目里可以随时手动同步。" : "已关闭，项目里的同步入口与徽标都不再显示。")</small>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" checked="@_adoEnabled" @onchange="e => _adoEnabled = e.Value is true" />
                                <span class="toggle-track"></span>
                            </label>
                        </div>

                        <label class="field">
                            <span>集合地址</span>
                            <input class="input" placeholder="http://172.30.184.25:8088/Utilities"
                                   @bind="_adoCollection" @bind:event="oninput" />
                        </label>

                        <label class="field">
                            <span>个人访问令牌（PAT）</span>
                            <input class="input" type="password"
                                   placeholder="@(_ado.HasPat ? "已保存；留空表示保持不变" : "粘贴 PAT（只保存在本地数据库）")"
                                   @bind="_adoPat" />
                        </label>

                        <div class="settings-ado-actions">
                            <button type="button" class="btn btn-primary" @onclick="SaveAdo" disabled="@_adoBusy">保存</button>
                            <button type="button" class="btn" @onclick="TestAdo" disabled="@_adoBusy">测试连接</button>
                        </div>

                        @if (_adoNotice is not null)
                        {
                            <p class="settings-footnote">@_adoNotice</p>
                        }

                        @if (_adoTest is not null)
                        {
                            <p class="@(_adoTest.Ok ? "settings-footnote" : "form-error")">@_adoTest.Message</p>
                        }

                        <p class="settings-footnote">
                            同步哪个云端项目、指派人、迭代范围，都在「项目 → 云端项目」里配；配好后再点「从 ADO 同步」。
                        </p>
                    </section>
                }
                else if (_section == "attachments")
                {
                    <section class="settings-section">
                        <header class="settings-section-head">
                            <h3>附件存储</h3>
                            <p>任务、项目、迭代都可以挂附件，文件按条目归集在下面这个目录。单文件上限 @MaxMegabytes MB；改目录后旧文件先留在原处，再点「一键迁移」搬过来。</p>
                        </header>

                        @if (_attachError is not null)
                        {
                            <p class="form-error">@_attachError</p>
                        }

                        <label class="field">
                            <span>附件目录</span>
                            <div class="field-row">
                                <input class="input" @bind="_attachRoot" @bind:event="oninput"
                                       placeholder="@_attach.DefaultDirectory" />
                                <button type="button" class="btn btn-ghost btn-sm"
                                        @onclick="BrowseAttachRoot" disabled="@(!Files.Available)">浏览…</button>
                            </div>
                        </label>

                        <div class="settings-attach-stats">
                            <div><strong>@_attach.FileCount</strong><span>附件</span></div>
                            <div><strong>@FormatSize(_attach.TotalBytes)</strong><span>占用空间</span></div>
                            <div><strong>@MaxMegabytes MB</strong><span>单文件上限</span></div>
                        </div>

                        @if (_attach.NeedsMigration && !string.IsNullOrWhiteSpace(_attach.PreviousRootDirectory))
                        {
                            <p class="settings-footnote">
                                还有附件在旧目录：@_attach.PreviousRootDirectory
                            </p>
                        }

                        <div class="settings-ado-actions">
                            <button type="button" class="btn btn-primary" @onclick="SaveAttach" disabled="@_attachBusy">保存</button>
                            <button type="button" class="btn" @onclick="SaveAndMigrateAttach" disabled="@_attachBusy">保存并迁移</button>
                            <button type="button" class="btn" @onclick="MigrateAttach"
                                    disabled="@(_attachBusy || !_attach.NeedsMigration)">一键迁移</button>
                            <button type="button" class="btn btn-ghost" @onclick="ResetAttachRoot" disabled="@_attachBusy">恢复默认目录</button>
                        </div>

                        @if (_attachNotice is not null)
                        {
                            <p class="settings-footnote">@_attachNotice</p>
                        }

                        <p class="settings-footnote">
                            删除任务 / 项目 / 迭代会先进回收站，7 天后连同附件文件一起清理。
                        </p>
                    </section>
                }
                else
                {
                    <section class="settings-section">
                        <header class="settings-section-head">
                            <h3>MCP 服务</h3>
                            <p>总开关关闭时，所有工具既不出现在工具列表，也无法被调用；逐项开关可以单独收敛权限。</p>
                        </header>

                        @if (_mcpError is not null)
                        {
                            <p class="form-error">@_mcpError</p>
                        }

                        <div class="settings-master @(_mcp.Enabled ? "" : "is-off")">
                            <div>
                                <strong>启用 MCP 服务</strong>
                                <small>@(_mcp.Enabled ? "外部助手可以按下方开关访问事序。" : "已对外关闭，工具列表为空。")</small>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" checked="@_mcp.Enabled" @onchange="ToggleMcp" />
                                <span class="toggle-track"></span>
                            </label>
                        </div>

                        <div class="settings-tool-list @(_mcp.Enabled ? "" : "is-disabled")">
                            @foreach (var tool in _mcp.Tools)
                            {
                                var current = tool;
                                <div class="settings-tool">
                                    <div class="settings-tool-main">
                                        <div class="settings-tool-title">
                                            <code>@current.Name</code>
                                            <span class="settings-tool-label">@current.Label</span>
                                            <span class="risk-badge risk-@current.Risk.ToString().ToLowerInvariant()">@RiskLabel(current.Risk)</span>
                                            @if (current.ReadOnly)
                                            {
                                                <span class="tag-mini">只读</span>
                                            }
                                        </div>
                                        <p>@current.Description</p>
                                    </div>
                                    <label class="toggle">
                                        <input type="checkbox"
                                               checked="@current.Enabled"
                                               disabled="@(!_mcp.Enabled)"
                                               @onchange="e => ToggleTool(current.Name, e)" />
                                        <span class="toggle-track"></span>
                                    </label>
                                </div>
                            }
                        </div>

                        <p class="settings-footnote">
                            写操作仍会走审批与审计；关闭开关不会删除历史审计记录。
                        </p>
                    </section>
                }
            </div>
        </div>
    </ChildContent>
</Modal>

@code {
    private static readonly ThemeOption[] Options =
    {
        new(ThemeMode.System, "monitor", "跟随系统", "与 Windows 的浅色/深色设置保持一致"),
        new(ThemeMode.Light, "sun", "浅色", "清爽的浅灰底，适合白天"),
        new(ThemeMode.Dark, "moon", "深色", "默认的深色界面，适合夜间"),
    };

    private string _section = "general";
    private McpSettingsDto _mcp = new();
    private string? _mcpError;

    private AdoConnectionDto _ado = new();
    private string _adoCollection = string.Empty;
    private string _adoPat = string.Empty;
    private bool _adoEnabled = true;
    private bool _adoBusy;
    private string? _adoError;
    private string? _adoNotice;
    private AdoConnectionTestDto? _adoTest;

    private AttachmentSettingsDto _attach = new() { RootDirectory = string.Empty, DefaultDirectory = string.Empty };
    private string _attachRoot = string.Empty;
    private bool _attachBusy;
    private string? _attachError;
    private string? _attachNotice;

    private static int MaxMegabytes => (int)(PlannerConstants.MaxAttachmentBytes / (1024 * 1024));

    protected override void Reload()
    {
        _mcp = Service.GetMcpSettings();
        ReloadAdo();
        ReloadAttach();
    }

    private void ShowGeneral() => _section = "general";

    private void ShowMcp() => _section = "mcp";

    private void ShowAdo()
    {
        _section = "ado";
        ReloadAdo();
    }

    private void ShowAttachments()
    {
        _section = "attachments";
        ReloadAttach();
    }

    private void ReloadAttach()
    {
        _attach = Service.GetAttachmentSettings();
        _attachRoot = _attach.RootDirectory;
        _attachError = null;
    }

    private void BrowseAttachRoot()
    {
        var picked = Files.PickFolder("选择附件存放目录", string.IsNullOrWhiteSpace(_attachRoot) ? null : _attachRoot);
        if (!string.IsNullOrWhiteSpace(picked))
        {
            _attachRoot = picked;
            _attachNotice = "已选择目录，点「保存」生效；旧目录里的文件可用「一键迁移」搬过来。";
        }
    }

    private void ResetAttachRoot()
    {
        _attachRoot = _attach.DefaultDirectory;
        _attachNotice = "已填回默认目录，点「保存」生效。";
    }

    private void SaveAttach()
    {
        _attachBusy = true;
        _attachError = null;
        _attachNotice = null;
        try
        {
            _attach = Service.SaveAttachmentSettings(new AttachmentSettingsInput
            {
                RootDirectory = _attachRoot,
                Migrate = false,
            });
            _attachRoot = _attach.RootDirectory;
            _attachNotice = _attach.NeedsMigration
                ? "已保存。旧目录里还有附件，点「一键迁移」搬过来。"
                : "已保存附件目录。";
        }
        catch (PlannerException ex)
        {
            _attachError = ex.Message;
        }
        finally
        {
            _attachBusy = false;
        }
    }

    private void SaveAndMigrateAttach()
    {
        _attachBusy = true;
        _attachError = null;
        _attachNotice = null;
        try
        {
            _attach = Service.SaveAttachmentSettings(new AttachmentSettingsInput
            {
                RootDirectory = _attachRoot,
                Migrate = false,
            });
            var result = Service.MigrateAttachments();
            _attach = Service.GetAttachmentSettings();
            _attachRoot = _attach.RootDirectory;
            _attachNotice = result.Message;
        }
        catch (PlannerException ex)
        {
            _attachError = ex.Message;
        }
        finally
        {
            _attachBusy = false;
        }
    }

    private void MigrateAttach()
    {
        _attachBusy = true;
        _attachError = null;
        _attachNotice = null;
        try
        {
            var result = Service.MigrateAttachments();
            _attach = Service.GetAttachmentSettings();
            _attachRoot = _attach.RootDirectory;
            _attachNotice = result.Message;
        }
        catch (PlannerException ex)
        {
            _attachError = ex.Message;
        }
        finally
        {
            _attachBusy = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024L * 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.#} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):0.##} GB",
    };

    private void ReloadAdo()
    {
        _ado = Ado.GetConnection();
        _adoCollection = _ado.CollectionUrl;
        _adoEnabled = _ado.Enabled;
        _adoPat = string.Empty;
        _adoError = null;
        _adoNotice = null;
        _adoTest = null;
    }

    private AdoConnectionInput AdoInput() => new()
    {
        Enabled = _adoEnabled,
        CollectionUrl = _adoCollection.Trim(),
        Pat = string.IsNullOrWhiteSpace(_adoPat) ? null : _adoPat.Trim(),
    };

    private void SaveAdo()
    {
        _adoError = null;
        _adoNotice = null;
        try
        {
            _ado = Ado.SaveConnection(AdoInput());
            _adoPat = string.Empty;
            _adoNotice = "已保存连接设置。";
        }
        catch (PlannerException ex)
        {
            _adoError = ex.Message;
        }
    }

    private async Task TestAdo()
    {
        _adoBusy = true;
        _adoError = null;
        _adoNotice = null;
        _adoTest = null;
        try
        {
            _adoTest = await Ado.TestConnectionAsync(AdoInput());
        }
        catch (PlannerException ex)
        {
            _adoError = ex.Message;
        }
        catch (Exception ex)
        {
            _adoError = ex.Message;
        }
        finally
        {
            _adoBusy = false;
        }
    }

    private async Task SetMode(ThemeMode mode)
    {
        if (Theme.Mode == mode)
        {
            return;
        }

        await Theme.SetModeAsync(mode);
        StateHasChanged();
    }

    private void ToggleMcp(ChangeEventArgs args)
    {
        var enabled = args.Value is true;
        Apply(() => _mcp = Service.SetMcpEnabled(enabled));
    }

    private void ToggleTool(string name, ChangeEventArgs args)
    {
        var enabled = args.Value is true;
        Apply(() => _mcp = Service.SetMcpToolEnabled(name, enabled));
    }

    private void Apply(Action action)
    {
        try
        {
            _mcpError = null;
            action();
        }
        catch (PlannerException ex)
        {
            _mcpError = ex.Message;
        }
    }

    private static string RiskLabel(RiskLevel risk) => risk switch
    {
        RiskLevel.High => "高风险",
        RiskLevel.Medium => "中风险",
        _ => "低风险",
    };

    private void Close() => Ui.CloseSettings();

    private sealed record ThemeOption(ThemeMode Mode, string Icon, string Label, string Hint);
}
