@using SDemo.App.Planner.Web.Components
@* 对外的 Blazor 小组件边界：只接收 DTO 与回调，不注入 PlannerService / PlannerUi。
   后续桌面组件或独立 Blazor 宿主可以直接复用这个组件，数据由宿主自己提供。 *@
<article class="planner-widget @(Compact ? "is-compact" : "")">
    <header class="planner-widget-head">
        <span class="widget-brand">S.</span>
        <div class="widget-heading">
            <strong>@(string.IsNullOrWhiteSpace(Title) ? "今天" : Title)</strong>
            <small>@DateTime.Today.ToString("M月d日 · dddd", CultureInfo.GetCultureInfo("zh-CN"))</small>
        </div>
        @if (RoutineTotal > 0)
        {
            <span class="widget-pill">日常 @RoutineDone/@RoutineTotal</span>
        }
    </header>

    @if (Todos.Count == 0)
    {
        <div class="widget-empty">今天没有排队的任务。</div>
    }
    else
    {
        <ul class="widget-list">
            @foreach (var todo in Todos.Take(MaxItems))
            {
                <li class="widget-item @(todo.Status == TodoStatus.Done ? "is-done" : "")">
                    <button class="widget-check @(todo.Status == TodoStatus.Done ? "checked" : "")"
                            title="@(todo.Status == TodoStatus.Done ? "重新打开" : "完成")"
                            @onclick="() => OnToggle.InvokeAsync(todo)">
                        @if (todo.Status == TodoStatus.Done)
                        {
                            <Icon Name="check" Size="11" />
                        }
                    </button>
                    <button class="widget-title" @onclick="() => OnOpen.InvokeAsync(todo)">
                        <span>@todo.Title</span>
                        @if (!string.IsNullOrWhiteSpace(todo.ProjectName))
                        {
                            <small><i class="project-dot" style="--dot:@(todo.ProjectColor ?? "#4C8DFF")"></i>@todo.ProjectName</small>
                        }
                    </button>
                </li>
            }
        </ul>
        @if (Todos.Count > MaxItems)
        {
            <footer class="widget-foot">还有 @(Todos.Count - MaxItems) 件</footer>
        }
    }
</article>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public IReadOnlyList<TodoDto> Todos { get; set; } = [];

    [Parameter]
    public int RoutineDone { get; set; }

    [Parameter]
    public int RoutineTotal { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public int MaxItems { get; set; } = 8;

    [Parameter]
    public EventCallback<TodoDto> OnToggle { get; set; }

    [Parameter]
    public EventCallback<TodoDto> OnOpen { get; set; }
}
