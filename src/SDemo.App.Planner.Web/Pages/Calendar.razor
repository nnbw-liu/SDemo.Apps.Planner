@page "/calendar"
@inherits PlannerPageBase

<PageTitle>日历 · 事序</PageTitle>

<section class="card calendar-card @(Compact ? "calendar-compact" : "")">
    <div class="calendar-head">
        <div class="calendar-heading">
            <button class="calendar-month" title="回到今天" @onclick="Today">
                @_month.ToString("yyyy年 M月", CultureInfo.GetCultureInfo("zh-CN"))
            </button>
            <div class="calendar-legend">
                <span><i class="legend-dot task"></i>任务</span>
                <span><i class="legend-dot event"></i>日程</span>
                <span><i class="legend-dot iteration"></i>迭代截止</span>
                <span><i class="legend-dot done"></i>已完成</span>
                <span><i class="legend-badge rest">休</i>休息日</span>
            </div>
        </div>

        <div class="calendar-nav">
            <button class="icon-btn" title="上个月" @onclick="() => Move(-1)"><Icon Name="chevron-right" Size="16" class="flip" /></button>
            <button class="icon-btn" title="下个月" @onclick="() => Move(1)"><Icon Name="chevron-right" Size="16" /></button>
            <button class="btn btn-ghost btn-sm" @onclick="() => Ui.OpenEvent(date: _selected)"><Icon Name="calendar" Size="14" /> 日程</button>
            <button class="btn btn-ghost btn-sm" @onclick="() => _holidayOpen = true"><Icon Name="calendar" Size="14" /> 假期</button>
        </div>
    </div>

    <div class="calendar-weekdays">
        @foreach (var day in Weekdays)
        {
            <span>@day</span>
        }
    </div>

    <div class="calendar-grid">
        @foreach (var cell in Cells)
        {
            var items = ItemsOn(cell.Date);
            var cellHoliday = HolidayOn(cell.Date);
            <button class="calendar-cell @(cell.IsCurrentMonth ? "" : "outside") @(cell.Date == DateTime.Today ? "today" : "") @(cell.Date == _selected ? "selected" : "") @(cell.IsWeekend ? "weekend" : "") @(cellHoliday is null ? "" : (cellHoliday.IsWorkday ? "has-holiday is-workday" : "has-holiday"))"
                    title="@(Compact ? "双击查看当天安排" : "点击查看当天安排")"
                    @onclick="() => Select(cell.Date)"
                    @ondblclick="() => OpenDay(cell.Date)">
                <div class="calendar-cell-head">
                    <span class="day-number">@cell.Date.Day</span>
                    @if (cellHoliday is not null)
                    {
                        <span class="holiday-badge @(cellHoliday.IsWorkday ? "work" : "rest")" title="@cellHoliday.Name">@(cellHoliday.IsWorkday ? "班" : "休")</span>
                    }
                    else if (cell.IsWeekend)
                    {
                        <span class="holiday-badge weekend" title="周末休息">休</span>
                    }
                    @if (cell.Date == DateTime.Today)
                    {
                        <span class="today-label">今天</span>
                    }
                </div>
                <div class="calendar-cell-items">
                    @if (cellHoliday is not null)
                    {
                        <span class="cell-holiday-name @(cellHoliday.IsWorkday ? "work" : "rest")">@cellHoliday.Name</span>
                    }
                    @foreach (var item in items.Take(MaxCellItems))
                    {
                        <span class="calendar-item @item.Class @(item.Done ? "done" : "") @(item.Closed ? "closed" : "") @(item.CompletedOnDay ? "completed-today" : "")"
                              style="--dot:@item.Color"
                              title="@ItemTooltip(item, cell.Date)">
                            @if (item.Kind == CalendarItemKind.Event)
                            {
                                <i class="item-time">@item.Time</i>
                            }
                            else if (item.Kind == CalendarItemKind.Iteration)
                            {
                                <i class="item-flag">截止</i>
                            }
                            else
                            {
                                <i class="item-dot" style="--dot:@item.Color"></i>
                            }
                            <span class="item-title">@item.Title</span>
                            @if (item.CompletedOnDay)
                            {
                                <i class="item-done-flag" title="当天完成"><Icon Name="check" Size="10" /></i>
                            }
                            @if (item.Cloud)
                            {
                                <i class="item-cloud" title="来自 Azure DevOps">ADO</i>
                            }
                        </span>
                    }
                    @if (items.Count > MaxCellItems)
                    {
                        <span class="calendar-more">+@(items.Count - MaxCellItems) 更多</span>
                    }
                </div>
                <span class="cell-add" title="在这天新建任务"
                      @onclick:stopPropagation="true"
                      @onclick="() => AddTask(cell.Date)">
                    <Icon Name="plus" Size="13" />
                </span>
            </button>
        }
    </div>
</section>

@if (!Compact)
{
    <section class="day-agenda card">
        <header class="card-head">
            <div>
                <span class="eyebrow">@_selected.ToString("dddd", CultureInfo.GetCultureInfo("zh-CN"))</span>
                <h3>@_selected.ToString("M月d日")</h3>
                @if (HolidayOn(_selected) is { } todayHoliday)
                {
                    <span class="holiday-chip @(todayHoliday.IsWorkday ? "work" : "rest")">
                        @(todayHoliday.IsWorkday ? "班" : "休") · @todayHoliday.Name
                    </span>
                }
            </div>
            <span class="muted">@SelectedTasks.Count 个任务 · @SelectedEvents.Count 个日程</span>
        </header>

        @if (SelectedTasks.Count == 0 && SelectedEvents.Count == 0)
        {
            <div class="empty-inline">
                <span class="empty-emoji">🌤️</span>
                <div>
                    <strong>这一天是空的</strong>
                    <p>没有任务和日程。留白也可以，或者现在加一件事。</p>
                </div>
                <button class="btn btn-ghost btn-sm" @onclick="() => Ui.OpenTask()">添加任务</button>
            </div>
        }
        else
        {
            <div class="agenda">
                @foreach (var evt in SelectedEvents)
                {
                    <div class="event-row event-row-click" @onclick="() => Ui.OpenEvent(evt)" role="button" tabindex="0">
                        <div class="event-time">
                            <strong>@evt.StartAt.ToLocalTime().ToString("HH:mm")</strong>
                            <span>@evt.EndAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="event-line"></div>
                        <div class="event-main">
                            <strong>@evt.Title</strong>
                            <small>@(string.IsNullOrWhiteSpace(evt.Location) ? "日程" : evt.Location)</small>
                        </div>
                    </div>
                }
                @foreach (var todo in SelectedTasks)
                {
                    <TaskRow Todo="todo" ShowProject="true" ShowCompletedToday="CompletedOn(todo, _selected)" />
                }
            </div>
        }
    </section>
}

@if (Compact && _dayOpen)
{
    <Modal Title="@DayTitle" Eyebrow="当天安排" SizeClass="modal-md" OnClose="CloseDay">
        <ChildContent>
            <div class="calendar-day-summary">
                @if (HolidayOn(_selected) is { } dayHoliday)
                {
                    <span class="holiday-chip @(dayHoliday.IsWorkday ? "work" : "rest")">
                        @(dayHoliday.IsWorkday ? "班" : "休") · @dayHoliday.Name
                    </span>
                }
                <span class="muted">@SelectedTasks.Count 个任务 · @SelectedEvents.Count 个日程</span>
            </div>

            @if (SelectedTasks.Count == 0 && SelectedEvents.Count == 0)
            {
                <div class="empty-inline">
                    <span class="empty-emoji">🌤️</span>
                    <div>
                        <strong>这一天是空的</strong>
                        <p>没有任务和日程。留白也可以，或者现在加一件事。</p>
                    </div>
                </div>
            }
            else
            {
                <div class="calendar-day-list">
                    @foreach (var evt in SelectedEvents)
                    {
                        <button class="calendar-day-item event" @onclick="() => EditEvent(evt)">
                            <span class="calendar-day-time">@evt.StartAt.ToLocalTime().ToString("HH:mm")</span>
                            <i class="legend-dot event"></i>
                            <span class="calendar-day-main">
                                <strong>@evt.Title</strong>
                                <small>@(string.IsNullOrWhiteSpace(evt.Location) ? "日程" : evt.Location)</small>
                            </span>
                        </button>
                    }
                    @foreach (var todo in SelectedTasks)
                    {
                        var completedToday = CompletedOn(todo, _selected);
                        <button class="calendar-day-item task @(IsDone(todo) ? "is-done" : "") @(IsClosed(todo) ? "is-closed" : "") @(completedToday ? "completed-today" : "")" @onclick="() => ShowTask(todo)">
                            <span class="calendar-day-time">@DayTime(todo)</span>
                            <i class="legend-dot" style="--dot:@(todo.ProjectColor ?? "#4C8DFF"); background:var(--dot)"></i>
                            <span class="calendar-day-main">
                                <span class="calendar-day-title">
                                    <strong>@todo.Title</strong>
                                    <AdoBadge Source="@todo.ExternalSource" ExternalId="@todo.ExternalId" />
                                    @if (completedToday)
                                    {
                                        <span class="done-on-chip" title="当天完成"><Icon Name="check" Size="9" /> 当天完成</span>
                                    }
                                </span>
                                <small>@(todo.ProjectName ?? "事序") · @StatusLabelOf(todo.Status)</small>
                            </span>
                        </button>
                    }
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-ghost btn-sm push-right" @onclick="AddEventForSelected"><Icon Name="calendar" Size="14" /> 加日程</button>
            <button class="btn btn-primary btn-sm" @onclick="AddTaskForSelected"><Icon Name="plus" Size="14" /> 新建任务</button>
        </Footer>
    </Modal>
}

@if (_holidayOpen)
{
    <HolidayManager Year="_month.Year" OnClose="() => _holidayOpen = false" OnChanged="Reload" />
}

@code {
    private static readonly string[] Weekdays = ["一", "二", "三", "四", "五", "六", "日"];

    /// <summary>组件模式：每格少显示一条，把六周整月压进一屏。</summary>
    [Parameter]
    public bool Compact { get; set; }

    private DateTime _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime _selected = DateTime.Today;
    private IReadOnlyList<TodoDto> _tasks = [];
    private IReadOnlyList<EventDto> _events = [];
    private IReadOnlyList<IterationDto> _iterations = [];
    private IReadOnlyDictionary<DateOnly, HolidayDto> _holidays = new Dictionary<DateOnly, HolidayDto>();
    private bool _holidayOpen;
    private bool _dayOpen;

    private int MaxCellItems => Compact ? 2 : 3;

    private string DayTitle => _selected.ToString("M月d日 dddd", CultureInfo.GetCultureInfo("zh-CN"));

    private IReadOnlyList<CalendarCell> Cells
    {
        get
        {
            var offset = RoutineDays.BitFor(_month.DayOfWeek);
            var start = _month.AddDays(-offset);
            return Enumerable.Range(0, 42)
                .Select(i =>
                {
                    var date = start.AddDays(i);
                    return new CalendarCell(
                        date,
                        date.Month == _month.Month && date.Year == _month.Year,
                        date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday);
                })
                .ToList();
        }
    }

    private IReadOnlyList<TodoDto> SelectedTasks =>
        _tasks.Where(t => DueOn(t, _selected) || CompletedOn(t, _selected))
            .OrderBy(t => IsDone(t))
            .ThenBy(t => t.DueAt is null)
            .ThenBy(t => t.DueAt ?? t.CompletedAt)
            .ToList();

    private IReadOnlyList<EventDto> SelectedEvents =>
        _events.Where(e => e.StartAt.ToLocalTime().Date == _selected)
            .OrderBy(e => e.StartAt)
            .ToList();

    protected override void Reload()
    {
        var offset = RoutineDays.BitFor(_month.DayOfWeek);
        var start = _month.AddDays(-offset);
        var end = start.AddDays(42);
        var from = new DateTimeOffset(start, TimeZoneInfo.Local.GetUtcOffset(start));
        var to = new DateTimeOffset(end, TimeZoneInfo.Local.GetUtcOffset(end));
        var range = Service.CalendarRange(from, to);
        _tasks = range.Todos;
        _events = range.Events;
        _iterations = range.Iterations;

        var years = new[] { start.Year, end.Year }.Distinct();
        _holidays = years
            .SelectMany(Service.ListHolidays)
            .GroupBy(h => h.Date)
            .ToDictionary(g => g.Key, g => g.First());
    }

    private HolidayDto? HolidayOn(DateTime date) =>
        _holidays.GetValueOrDefault(DateOnly.FromDateTime(date));

    protected override void OnParametersSet()
    {
        if (_selected < _month || _selected >= _month.AddMonths(1))
        {
            _selected = _month;
        }
    }

    private void Move(int delta)
    {
        _month = _month.AddMonths(delta);
        _selected = _month;
        Reload();
    }

    private void Today()
    {
        _month = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _selected = DateTime.Today;
        Reload();
    }

    private void Select(DateTime date)
    {
        _selected = date;
        if (date.Month != _month.Month || date.Year != _month.Year)
        {
            _month = new DateTime(date.Year, date.Month, 1);
            Reload();
        }
    }

    private void OpenDay(DateTime date)
    {
        if (!Compact)
        {
            Select(date);
            return;
        }

        Select(date);
        _dayOpen = true;
    }

    private void CloseDay() => _dayOpen = false;

    private void AddTask(DateTime date)
    {
        _selected = date;
        Ui.OpenTask(dueDate: date.Date);
    }

    private void AddTaskForSelected()
    {
        _dayOpen = false;
        Ui.OpenTask(dueDate: _selected.Date);
    }

    private void AddEventForSelected()
    {
        _dayOpen = false;
        Ui.OpenEvent(date: _selected.Date);
    }

    private void EditEvent(EventDto evt)
    {
        _dayOpen = false;
        Ui.OpenEvent(evt);
    }

    private void ShowTask(TodoDto todo)
    {
        _dayOpen = false;
        Ui.OpenTaskDetail(todo);
    }

    private static bool IsDone(TodoDto todo) =>
        todo.Status is TodoStatus.Done or TodoStatus.Verified or TodoStatus.Closed;

    /// <summary>已关闭 / 已取消才是终态；已完成、已验证后面还有验证与关闭两步，不画删除线。</summary>
    private static bool IsClosed(TodoDto todo) =>
        todo.Status is TodoStatus.Closed or TodoStatus.Canceled;

    private static bool DueOn(TodoDto todo, DateTime date) =>
        todo.DueAt is { } due && due.ToLocalTime().Date == date;

    /// <summary>完成日期与查看日期相同；取消不算完成。</summary>
    private static bool CompletedOn(TodoDto todo, DateTime date) =>
        IsDone(todo) && todo.CompletedAt is { } done && done.ToLocalTime().Date == date;

    /// <summary>月格条目的悬浮说明：区分任务、日程和迭代截止。</summary>
    private static string ItemTooltip(CalendarItem item, DateTime date) => item.Kind switch
    {
        CalendarItemKind.Event => $"{item.Title} · {item.Time}",
        CalendarItemKind.Iteration => $"迭代「{item.Title}」· 截止 {date.ToString("M月d日", CultureInfo.GetCultureInfo("zh-CN"))}"
            + (item.Done ? "（已结束）" : string.Empty),
        _ when item.CompletedOnDay => $"{item.Title} · 当天完成",
        _ => item.Title,
    };

    /// <summary>当天弹窗的时间列：优先截止时间，其次当天完成时间。</summary>
    private string DayTime(TodoDto todo)
    {
        if (todo.DueAt is { } due && due.ToLocalTime().Date == _selected)
        {
            return due.ToLocalTime().ToString("HH:mm");
        }

        if (todo.CompletedAt is { } done && done.ToLocalTime().Date == _selected)
        {
            return done.ToLocalTime().ToString("HH:mm");
        }

        return "全天";
    }

    private static string StatusLabelOf(TodoStatus status) => status switch
    {
        TodoStatus.Doing => "进行中",
        TodoStatus.Done => "已完成",
        TodoStatus.Verified => "已验证",
        TodoStatus.Closed => "已关闭",
        TodoStatus.Canceled => "已取消",
        _ => "新建",
    };

    private IReadOnlyList<CalendarItem> ItemsOn(DateTime date)
    {
        var items = new List<CalendarItem>();
        foreach (var evt in _events.Where(e => e.StartAt.ToLocalTime().Date == date))
        {
            items.Add(new CalendarItem(
                evt.Id,
                CalendarItemKind.Event,
                evt.Title,
                evt.StartAt.ToLocalTime().ToString("HH:mm"),
                "#A78BFA",
                false,
                false,
                false,
                false,
                false,
                "event"));
        }

        foreach (var iteration in _iterations.Where(i => i.EndAt is { } end && end.ToLocalTime().Date == date))
        {
            items.Add(new CalendarItem(
                iteration.Id,
                CalendarItemKind.Iteration,
                iteration.ParentName is { Length: > 0 } parent ? $"{parent} / {iteration.Name}" : iteration.Name,
                "截止",
                iteration.ProjectColor ?? "#4C8DFF",
                iteration.Status is IterationStatus.Done or IterationStatus.Archived,
                iteration.Status is IterationStatus.Done or IterationStatus.Archived,
                false,
                false,
                iteration.ExternalSource == AdoMapper.SourceName,
                "iteration"));
        }

        foreach (var todo in _tasks)
        {
            var dueOn = DueOn(todo, date);
            var completedOn = CompletedOn(todo, date);
            if (!dueOn && !completedOn)
            {
                continue;
            }

            var time = dueOn
                ? todo.DueAt!.Value.ToLocalTime().ToString("HH:mm")
                : todo.CompletedAt!.Value.ToLocalTime().ToString("HH:mm");

            items.Add(new CalendarItem(
                todo.Id,
                CalendarItemKind.Task,
                todo.Title,
                time,
                todo.ProjectColor ?? "#4C8DFF",
                IsDone(todo),
                IsClosed(todo),
                completedOn,
                completedOn && !dueOn,
                todo.ExternalSource == AdoMapper.SourceName,
                "task"));
        }

        // 只看完成时间进来的任务排在后面；迭代截止放最前，别被当天任务挤掉。
        return items
            .OrderBy(i => i.CompletionOnly)
            .ThenBy(i => i.Kind == CalendarItemKind.Iteration ? 0 : 1)
            .ThenBy(i => i.Time)
            .ToList();
    }

    private sealed record CalendarCell(DateTime Date, bool IsCurrentMonth, bool IsWeekend);

    private enum CalendarItemKind
    {
        Task,
        Event,
        Iteration,
    }

    private sealed record CalendarItem(
        string Id,
        CalendarItemKind Kind,
        string Title,
        string Time,
        string Color,
        bool Done,
        bool Closed,
        bool CompletedOnDay,
        bool CompletionOnly,
        bool Cloud,
        string Class);
}
