<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- 纯 Blazor UI：WPF 只是外壳，所有页面/组件在这里，可被桌面组件或未来宿主复用。 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SDemo.App.Planner.Web</RootNamespace>
    <AssemblyName>SDemo.App.Planner.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDemo.App.Planner.Contracts\SDemo.App.Planner.Contracts.csproj" />
    <ProjectReference Include="..\SDemo.App.Planner.Core\SDemo.App.Planner.Core.csproj" />
  </ItemGroup>

</Project>
